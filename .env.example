# Copy to .env.local for local development. Never commit real values.
# Every NEXT_PUBLIC_* value is inlined into the static bundle and is
# public by design — never put a secret in one.

# Canonical origin used in metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=

# Supabase project the browser talks to: https://<ref>.supabase.co and its
# publishable (anon) key. There is no built-in default. Leave both empty to
# run with no backend: reports stay in the browser and the community page
# says the shared database is not connected. For local e2e any
# https://<name>.supabase.co works — the specs stub every Supabase request.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Operator / test-only. Never NEXT_PUBLIC_, never in the browser.
# Used by scripts/forward-report.mjs and the service-role half of
# npm run test:security.
SUPABASE_SERVICE_KEY=

# Separate TEST Supabase project for npm run test:security. Never production.
SUPABASE_TEST_URL=
SUPABASE_TEST_KEY=
SUPABASE_TEST_SERVICE_KEY=
# Set to 1 to run the forged-header network-limit probe (uses up the hourly allowance).
SECURITY_PROBE_NETWORK=
